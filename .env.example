# Copy this file to .env and adjust as needed. docker-compose.yml reads these.

POSTGRES_USER=inflow
POSTGRES_PASSWORD=inflow
POSTGRES_DB=inflow
POSTGRES_PORT=5432

APP_DATABASE_URL=postgresql+psycopg://inflow:inflow@db:5432/inflow
APP_ENVIRONMENT=development
BACKEND_PORT=8010

FRONTEND_PORT=5173
# Used by the Vite dev-server proxy inside the frontend container so /api
# requests reach the backend container by its Compose service name.
API_PROXY_TARGET=http://backend:8000
